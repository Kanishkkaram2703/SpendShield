SPENDSHIELD_APP_NAME=SpendShield Backend
SPENDSHIELD_APP_VERSION=0.1.0
SPENDSHIELD_ENVIRONMENT=development
SPENDSHIELD_DEBUG=false
SPENDSHIELD_API_PREFIX=/api/v1
SPENDSHIELD_LOG_LEVEL=INFO
# Comma-separated host allowlist. Update the LAN address for Expo Go.
# Required in staging/production; wildcard hosts are not allowed there.
SPENDSHIELD_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.165.59.245

# MongoDB foundation configuration.
SPENDSHIELD_MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
SPENDSHIELD_MONGODB_DATABASE=spendshield
# Development uses the isolated single-node rs0 instance on 27018.
SPENDSHIELD_MONGODB_REPLICA_SET=rs0
# The existing standalone Windows service on 127.0.0.1:27017 is not the
# SpendShield development endpoint and must remain unmodified.
SPENDSHIELD_MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
SPENDSHIELD_MONGODB_CONNECT_TIMEOUT_MS=3000

# Cassandra foundation configuration.
SPENDSHIELD_CASSANDRA_HOSTS=127.0.0.1
SPENDSHIELD_CASSANDRA_PORT=9042
SPENDSHIELD_CASSANDRA_KEYSPACE=spendshield_events
SPENDSHIELD_CASSANDRA_USERNAME=
SPENDSHIELD_CASSANDRA_PASSWORD=
SPENDSHIELD_CASSANDRA_CONNECT_TIMEOUT_SECONDS=5
SPENDSHIELD_CASSANDRA_REPLICATION_FACTOR=1

# Authentication settings. Use a long random value outside tests.
SPENDSHIELD_AUTH_SECRET_KEY=change-this-development-secret-to-a-long-random-value
SPENDSHIELD_AUTH_ALGORITHM=HS256
SPENDSHIELD_AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
SPENDSHIELD_AUTH_ISSUER=spendshield-api
SPENDSHIELD_AUTH_AUDIENCE=spendshield-client

# Fictional Phase 3 account defaults.
SPENDSHIELD_ACCOUNT_INITIAL_BALANCE=10000.00
SPENDSHIELD_ACCOUNT_CURRENCY=INR

# Reserved for the evidence-storage phase.
SPENDSHIELD_EVIDENCE_STORAGE_PATH=./storage/evidence

# Research-only anomaly artifacts. The backend loads versioned JSON metadata
# and fitted parameters; it never regenerates data or trains at startup.
SPENDSHIELD_RESEARCH_ANOMALY_ARTIFACT_PATH=./data/synthetic/anomaly_detection/v2
